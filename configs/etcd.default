# /etc/default/etcd - etcd mono-nœud (DCS Patroni) sur pgsql-lb
ETCD_NAME=etcd-lb
ETCD_DATA_DIR=/var/lib/etcd/wms
ETCD_LISTEN_PEER_URLS=http://192.168.10.62:2380
ETCD_LISTEN_CLIENT_URLS=http://192.168.10.62:2379,http://127.0.0.1:2379
ETCD_ADVERTISE_CLIENT_URLS=http://192.168.10.62:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://192.168.10.62:2380
ETCD_INITIAL_CLUSTER=etcd-lb=http://192.168.10.62:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=wms-etcd-token
ETCD_ENABLE_V2=false
